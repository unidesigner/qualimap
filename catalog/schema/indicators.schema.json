{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unidesigner/qualimap/catalog/schema/indicators.schema.json",
  "title": "Qualimap catalog",
  "type": "object",
  "required": [
    "meta",
    "dimensions",
    "sources",
    "indicators"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "catalog_version",
        "grid",
        "region",
        "languages"
      ],
      "properties": {
        "catalog_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "grid": {
          "type": "object",
          "required": [
            "system",
            "base_resolution"
          ],
          "properties": {
            "system": {
              "const": "a5"
            },
            "base_resolution": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "export_resolutions": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 30
              }
            }
          }
        },
        "region": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "boundary_source": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "score_quantization": {
          "type": "object",
          "properties": {
            "scale": {
              "type": "number"
            },
            "nodata": {
              "type": "integer"
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "default_weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/i18n"
          },
          "default_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ramp": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "osm_poi_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tags"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_:]+=[A-Za-z0-9_*]+$"
            }
          }
        }
      }
    },
    "indicators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indicator"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "i18n": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^P(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?$"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "title",
        "kind",
        "license",
        "fetch",
        "refresh"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "layer_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "raster",
            "vector",
            "table",
            "api",
            "tiles"
          ]
        },
        "crs": {
          "type": "string",
          "pattern": "^EPSG:\\d+$"
        },
        "license": {
          "type": "object",
          "required": [
            "id",
            "attribution"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "attribution": {
              "type": "string"
            }
          }
        },
        "fetch": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "stac",
                "http",
                "estv_api",
                "osm_pbf",
                "gtfs",
                "custom",
                "none"
              ]
            },
            "collection": {
              "type": "string"
            },
            "asset_media_type": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "per_tile": {
              "type": "boolean"
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rate_limit": {
              "type": "object"
            },
            "params": {
              "type": "object"
            },
            "class": {
              "type": "string",
              "description": "Python entry point for method=custom"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "stac"
                  }
                }
              },
              "then": {
                "required": [
                  "collection"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "method": {
                    "enum": [
                      "http",
                      "osm_pbf",
                      "gtfs"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "url"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "estv_api"
                  }
                }
              },
              "then": {
                "required": [
                  "base_url",
                  "operations"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "custom"
                  }
                }
              },
              "then": {
                "required": [
                  "class"
                ]
              }
            }
          ]
        },
        "refresh": {
          "type": "object",
          "required": [
            "every",
            "check"
          ],
          "properties": {
            "every": {
              "$ref": "#/$defs/duration"
            },
            "check": {
              "enum": [
                "checksum",
                "etag",
                "always"
              ]
            }
          }
        },
        "used_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raster_zarr": {
              "type": "boolean",
              "description": "Republish this raster as GeoZarr for the viewer's ZarrLayer"
            }
          }
        }
      }
    },
    "indicator": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "title",
        "inputs",
        "transform",
        "unit",
        "aggregation",
        "normalize"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "dimension": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "scored": {
          "type": "boolean",
          "default": true
        },
        "title": {
          "$ref": "#/$defs/i18n"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "transform": {
          "type": "object",
          "required": [
            "fn",
            "version"
          ],
          "properties": {
            "fn": {
              "type": "string",
              "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "params": {
              "type": "object"
            }
          }
        },
        "unit": {
          "type": "string"
        },
        "level": {
          "enum": [
            "cell",
            "commune"
          ],
          "default": "cell"
        },
        "aggregation": {
          "enum": [
            "pop_weighted_mean",
            "pop_weighted_energetic_mean",
            "area_mean",
            "commune_broadcast",
            "max",
            "sum"
          ]
        },
        "normalize": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "linear",
                "log_decay",
                "percentile",
                "lookup"
              ]
            },
            "good": {
              "type": "number"
            },
            "bad": {
              "type": "number"
            },
            "direction": {
              "enum": [
                "higher_is_better",
                "lower_is_better"
              ]
            },
            "weight": {
              "enum": [
                "population",
                "none"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "linear"
                  }
                }
              },
              "then": {
                "required": [
                  "good",
                  "bad"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "percentile"
                  }
                }
              },
              "then": {
                "required": [
                  "direction"
                ]
              }
            }
          ]
        },
        "qa": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check"
            ],
            "properties": {
              "check": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
