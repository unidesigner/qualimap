# Copy to .env (git-ignored). Without S3 settings the pipeline writes to .qm/data and .qm/pub.

# Backblaze B2 (S3-compatible API)
QM_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
QM_S3_REGION=eu-central-003
QM_S3_KEY_ID=
QM_S3_SECRET=
# private: raw/, staged/, indicators/, state/
QM_BUCKET_DATA=qualimap-data
# public read: releases/
QM_BUCKET_PUB=qualimap-pub

# Or point at any fsspec URL instead of the two buckets (e.g. file:///srv/qm/pub)
# QM_DATA_URL=
# QM_PUB_URL=

# Public URL of the pub bucket (written into latest.json and catalog.json)
QM_PUBLIC_BASE_URL=https://f003.backblazeb2.com/file/qualimap-pub
# Origins allowed by the CORS rules that `qm cors apply` writes
QM_VIEWER_ORIGINS=https://qualimap.ch,http://localhost:3000,http://localhost:5173

# Optional
# QM_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# QM_CACHE_DIR=~/.cache/qualimap

# Upstream locations referenced as ${VAR} in catalog/indicators.yaml. These change with each
# publication year (FSO/geo.admin download links), so they live in the environment rather
# than in the catalog.
# GWR buildings/dwellings extract (CSV)
QM_GWR_URL=
# STATPOP hectare grid (CSV)
QM_STATPOP_URL=
# population column of that year's file
QM_STATPOP_POP_COLUMN=BBTOT
# Arealstatistik NOLC04 hectare points (CSV)
QM_NOLC04_URL=
# land-cover column of the latest survey
QM_NOLC04_CODE_COLUMN=
# official commune register (XML)
QM_COMMUNE_REGISTER_URL=
# opentransportdata.swiss GTFS timetable (ZIP)
QM_GTFS_URL=
